 ;
# ============================================
# EDUCDIM - MODÈL VARYAB ANVIWÒNMAN
# ============================================
# Kopye fich sa a an .env epi ranpli valè yo

# SECURITY
SECRET_KEY=your-secret-key-here
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

# DATABASE
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/educdim

# BREVO (EMAIL) - Sendinblue
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@educdim.com
BREVO_SENDER_NAME=EducDim

# TELERIVET (SMS)
TELERIVET_API_KEY=your-telerivet-api-key-here
TELERIVET_PROJECT_ID=your-telerivet-project-id-here

# SITE
SITE_NAME=EducDim
SITE_URL=https://educdim.com

# SECURE SSL (Production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
